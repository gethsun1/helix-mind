HELIXMIND_ENVIRONMENT=production
HELIXMIND_HOST=127.0.0.1
HELIXMIND_PORT=8401
HELIXMIND_CORS_ORIGINS=https://helix-mind-green.vercel.app
HELIXMIND_DATABASE_URL=postgresql+psycopg:///helixmind
HELIXMIND_REDIS_URL=redis://127.0.0.1:6381/0
HELIXMIND_LITERATURE_MAX_RESULTS=10
HELIXMIND_LITERATURE_TIMEOUT_SECONDS=20
# Optional but recommended by NCBI E-utilities usage guidance.
HELIXMIND_NCBI_EMAIL=
HELIXMIND_AUTH_SECRET=replace-with-a-long-random-helixmind-only-secret
HELIXMIND_AUTH_SYNC_SECRET=replace-with-a-second-long-random-helixmind-only-secret
HELIXMIND_ADMIN_EMAIL=gethsun09@gmail.com
